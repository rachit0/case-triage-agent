# Copy to .env and fill in a free key.  cp .env.example .env
#
# --- Groq (default; free key at https://console.groq.com/keys) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_your_key_here
LLM_MODEL=qwen/qwen3.6-27b

# --- Google AI Studio (https://aistudio.google.com/apikey) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-2.0-flash

# --- OpenRouter (https://openrouter.ai/keys) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Ollama, local, no key (ollama pull llama3.1) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Force the deterministic offline planner even if a key is present.
# LLM_OFFLINE=1

# Agent bounds (enforced in code, see app/agent.py)
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=6
LLM_MAX_RETRIES=4
